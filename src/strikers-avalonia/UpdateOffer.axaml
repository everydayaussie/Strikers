<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Strikers.App.UpdateOffer"
        Title="Strikers update"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <StackPanel Name="Body" Margin="24,20,24,20" Spacing="12">
    <TextBlock Name="Headline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
               Text="A new version of Strikers is out" />

    <TextBlock Name="Versions" FontSize="13" TextWrapping="Wrap" />

    <TextBlock Name="Trouble" FontSize="12" TextWrapping="Wrap" IsVisible="False" />

    <StackPanel Name="Buttons" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
      <Button Name="OpenButton" Content="Open the Nexus page" />
      <Button Name="LaterButton" Content="Later" />
    </StackPanel>
  </StackPanel>

</Window>
