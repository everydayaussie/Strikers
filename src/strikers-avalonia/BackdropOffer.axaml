<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Strikers.App.BackdropOffer"
        Title="Strikers background image"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <StackPanel Name="Body" Margin="24,20,24,20" Spacing="12">
    <TextBlock Name="Headline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
               Text="Download the background image?" />

    <StackPanel Name="ProgressRow" Spacing="6" IsVisible="False">
      <ProgressBar Name="Bar" Minimum="0" Maximum="100" Height="8" />
      <TextBlock Name="ProgressNote" FontSize="12" />
    </StackPanel>

    <TextBlock Name="Trouble" FontSize="12" TextWrapping="Wrap" IsVisible="False" />

    <StackPanel Name="Buttons" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
      <Button Name="DownloadButton" Content="Download" />
      <Button Name="LaterButton" Content="Not now" />
      <Button Name="NeverButton" Content="Never show again" />
      <Button Name="CancelButton" Content="Cancel" IsVisible="False" />
    </StackPanel>
  </StackPanel>

</Window>
