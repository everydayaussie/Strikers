<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>live-probe</AssemblyName>
    <RootNamespace>Strikers.LiveProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(TestBuildFor)' != ''">
    <AssemblyMetadata Include="TestBuildFor" Value="$(TestBuildFor)" />
    <AssemblyMetadata Include="TestBuildExpires" Value="$(TestBuildExpires)" />
  </ItemGroup>

  <ItemGroup Condition="'$(LauncherOnly)' == 'true'">
    <AssemblyMetadata Include="LauncherOnly" Value="true" />
  </ItemGroup>
</Project>
